{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "remind-web",
	// 账号 ID 不写进仓库（仓库是公开的），部署时由 CLOUDFLARE_ACCOUNT_ID 环境变量提供
	"account_id": "<your-cloudflare-account-id>",
	"compatibility_date": "2026-05-29",
	// 纯静态 Worker：直接托管 dist 构建产物，SPA 路由回退到 index.html
	"assets": {
		"directory": "dist",
		"not_found_handling": "single-page-application"
	},
	// 绑定到 taojun.top 子域（wrangler 会自动建 DNS 与证书）
	"workers_dev": false,
	"routes": [
		{ "pattern": "remind.taojun.top", "custom_domain": true }
	]
}
